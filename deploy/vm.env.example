# This file is copied to /opt/carecoordinator/.env on the VM and is never
# committed with real values.
APP_DOMAIN=api.example.org
ACME_EMAIL=ops@example.org

ENVIRONMENT=production
CHAT_MODEL=google_genai:gemini-2.5-flash
GOOGLE_API_KEY=replace-with-gemini-key
REDIS_URL=redis://replace-with-managed-redis-host:6379/0
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_DATABASE_ID=auth-tokens-calendar
DEFAULT_HOSPITAL_ID=replace-with-default-hospital-id

# Agent and booking policy
MIN_ELIGIBLE_AGE=12
MAX_ELIGIBLE_AGE=25
CRISIS_SUPPORT_LINE=
CALENDAR_HEALTH_TTL_MINUTES=15

# JSON list required by pydantic-settings for a List[str] field.
CORS_ORIGINS=["https://api.example.org"]

# Host paths. The Compose file mounts these into the app container.
FIREBASE_CREDENTIALS_PATH=/opt/carecoordinator/secrets/firebase-service-account.json
GOOGLE_CLIENT_SECRETS_PATH=/opt/carecoordinator/secrets/google-oauth-client.json

# Outlook / Microsoft Graph, if enabled.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
