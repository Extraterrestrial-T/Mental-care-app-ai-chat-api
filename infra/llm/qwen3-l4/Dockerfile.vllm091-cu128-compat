FROM docker.io/vllm/vllm-openai@sha256:0b51ec38fb965b44f6aa75d8d847c5f21bc062b7140e1d83444b39b67fc4a2ea

USER root

# Cloud Run L4 hosts expose a 535-series driver (CUDA 12.2 capability). The
# vLLM 0.9.1 image is built for CUDA 12.8, so use NVIDIA's forward-compatibility
# driver library rather than the incompatible CUDA 12.9 library used before.
RUN apt-get update \
    && apt-get install -y --no-install-recommends cuda-compat-12-8 \
    && rm -rf /var/lib/apt/lists/*

ENV VLLM_ENABLE_CUDA_COMPATIBILITY=1
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.8/compat:/usr/local/nvidia/lib64:${LD_LIBRARY_PATH}
